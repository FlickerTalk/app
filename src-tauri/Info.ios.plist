<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Voice and video calls (Plan §66) and scanning Contact Cards; asked for only when needed (§30). -->
	<key>NSCameraUsageDescription</key>
	<string>FlickerTalk uses the camera for video calls and to scan contact codes.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>FlickerTalk uses the microphone for calls.</string>
	<!-- 2026-09-28: PushKit rings calls through CallKit (voip), a call keeps its audio in the
	     background (audio), and the router's wake-ups arrive (remote-notification). -->
	<!-- 2026-09-28: iOS 27 no longer launches an app without the scene life cycle
	     (_UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption). tao answers the
	     scene configuration itself (TaoSceneDelegate), but only when multiple scenes are on
	     (tao 0.35 multiple_scenes_enabled). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<!-- 2026-09-29, native video: CallKit's "Video" button opens the app with a call intent's
	     user activity, which turns our camera on (PlatformPlugin, CallIntentActivities). -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INStartCallIntent</string>
		<string>INStartVideoCallIntent</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
</dict>
</plist>
