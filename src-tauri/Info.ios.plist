<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>FlickerTalk uses the camera for video calls and to scan contact codes.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>FlickerTalk uses the microphone for calls.</string>
	<!-- When in use only. No "always" key and no location background mode. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FlickerTalk uses your location only when you choose to share where you are in a chat.</string>
	<!-- iOS 27 won't launch an app without the scene life cycle, and tao only answers the scene
	     configuration itself when multiple scenes are on. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<!-- CallKit's Video button opens the app with one of these user activities. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>INStartCallIntent</string>
		<string>INStartVideoCallIntent</string>
	</array>
	<!-- voip for PushKit calls, audio for calls in the background, remote-notification for wake-ups -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
</dict>
</plist>
