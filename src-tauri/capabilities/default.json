{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the WebView may ask of Tauri: events, the app's version and opening mail (reports, §36). Everything else goes through the app's own commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:app:allow-version",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "mailto:*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ]
}
