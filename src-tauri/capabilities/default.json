{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the WebView may ask of Tauri: events, the app's version, opening mail, web links and, on Android, a place in the maps app (geo:). Everything else goes through the app's own commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:app:allow-version",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "mailto:*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "geo:*"
        }
      ]
    }
  ]
}
