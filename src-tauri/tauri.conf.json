{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flickertalk",
  "version": "0.1.0",
  "identifier": "com.flickertalk.flickertalk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "flickertalk",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/files/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
