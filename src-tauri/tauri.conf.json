{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlickerTalk",
  "version": "0.1.0",
  "identifier": "com.flickertalk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "FlickerTalk",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob: mediastream:",
        "connect-src": "'self' ipc: http://ipc.localhost data:",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "ftplugin: http://ftplugin.localhost",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/files/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/plugins/*.ftplugin"
    ]
  },
  "mainBinaryName": "flickertalk"
}
