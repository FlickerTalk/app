<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- An incoming call vibrates as the phone is set to (§66). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Wake-ups from the router show a notification when the app is not open (M4). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- §66: an incoming call shows on the screen, over the lock screen if the phone is locked. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Local reminders (2026-09-27): exact alarms where the user allows them, and setting them
         again after a reboot. USE_EXACT_ALARM is not asked for: Play keeps it for alarm apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Native calls (2026-09-28): the call's audio lives in Rust, not in the WebView. A foreground
         service of type phoneCall|microphone keeps the microphone working with the app in the
         background (Android 14); phoneCall needs MANAGE_OWN_CALLS (a normal permission, the one
         self-managed calling apps hold). RECORD_AUDIO is asked for when a call starts (§30). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Native video (2026-09-29): the camera is asked for when the user turns it on (§30); the
         call's service adds the camera type while the call has video. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <application>
        <receiver android:name="com.flickertalk.platform.ReminderReceiver" android:exported="false" />
        <receiver android:name="com.flickertalk.platform.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- A login (drive) sends the user back here; the URL goes to the app and this closes. -->
        <activity
            android:name="com.flickertalk.platform.AuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.flickertalk.app" />
                <!-- Google's OAuth clients for Android redirect to the client id, reversed; the
                     app's build fills it in from FT_GOOGLE_CLIENT_ID (plan-drive). -->
                <data android:scheme="${googleRedirectScheme}" />
            </intent-filter>
        </activity>
        <service
            android:name="com.flickertalk.platform.FtMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- A native call in progress (2026-09-28): its ongoing notification, and its hang-up and
             mute buttons, which go to the core through the call-event channel; camera while the
             call has video (2026-09-29). -->
        <service
            android:name="com.flickertalk.platform.FtCallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />
        <receiver android:name="com.flickertalk.platform.FtCallActionReceiver" android:exported="false" />
        <!-- A call push with the app closed (2026-10-01): while its call rings, this keeps the
             process (and the core the push started in it) awake, holding the call notification.
             Type phoneCall, which MANAGE_OWN_CALLS allows; started within FCM's allowance. -->
        <service
            android:name="com.flickertalk.platform.FtIncomingCallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />
        <!-- The notifications' buttons (2026-09-29): answer, decline, the call's camera and a
             reminder land here. It hands the tap to the process at once, then opens the app if it
             must: an extra on the launcher's intent got lost when the process had died. Private,
             over the lock screen (no unlock to decline), its own task, out of recents. -->
        <activity
            android:name="com.flickertalk.platform.FtNotificationTapActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Lends a file of the app to the viewer the user picks, only for that viewing (§62). -->
        <provider
            android:name="com.flickertalk.platform.FtFileProvider"
            android:authorities="${applicationId}.ft.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ft_file_paths" />
        </provider>
    </application>
</manifest>
